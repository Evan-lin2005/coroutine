# P0 external correctness tests — links library objects without modifying sources.
# Usage: make -f Makefile.p0 [test|bench|clean]

CC      ?= gcc
CFLAGS  = -std=c17 -Wall -Wextra -Werror -O2 -g -I. -Iplatform/Linux_x86 -Itests/p0
LDFLAGS = -pthread

LIB_C   = coroutine.c platform/Linux_x86/SystemV.c
LIB_ASM = platform/Linux_x86/sysV.S
LIB_OBJ = $(LIB_C:.c=.o) $(LIB_ASM:.S=.o)

P0_SRCS = tests/p0/p0_common.c tests/p0/test_p0_main.c tests/p0/test_regs.c \
          tests/p0/test_guard.c tests/p0/test_lifecycle.c tests/p0/test_stack_bounds.c
P0_OBJS = $(P0_SRCS:.c=.o)

.PHONY: all test bench clean libobjs test-asan

all: test_p0 bench_switch

test-asan:
	$(MAKE) -f Makefile.p0 clean test_p0 \
		CFLAGS='$(CFLAGS) -fsanitize=address -fno-omit-frame-pointer' \
		LDFLAGS='$(LDFLAGS) -fsanitize=address'
	./test_p0

libobjs: $(LIB_OBJ)

test_p0: $(LIB_OBJ) $(P0_OBJS)
	$(CC) $(CFLAGS) -o $@ $(LIB_OBJ) $(P0_OBJS) $(LDFLAGS)

bench_switch: $(LIB_OBJ) tests/p0/bench_switch.o
	$(CC) $(CFLAGS) -o $@ $(LIB_OBJ) tests/p0/bench_switch.o $(LDFLAGS)

test: test_p0
	./test_p0

bench: bench_switch
	./bench_switch --iter=100000

# test_regs 內聯 asm 會讀寫 rbp；需 -fomit-frame-pointer 避免 GCC「bp cannot be used in asm」
tests/p0/test_regs.o: tests/p0/test_regs.c
	$(CC) $(CFLAGS) -O0 -fomit-frame-pointer -c -o $@ $<

# test_guard 故意遞迴撞 guard page；gcc 13+ -Werror=infinite-recursion 會擋編譯
tests/p0/test_guard.o: tests/p0/test_guard.c
	$(CC) $(CFLAGS) -Wno-infinite-recursion -fno-optimize-sibling-calls -c -o $@ $<

tests/p0/%.o: tests/p0/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

platform/Linux_x86/%.o: platform/Linux_x86/%.S
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(LIB_OBJ) $(P0_OBJS) tests/p0/bench_switch.o test_p0 bench_switch test_p0_asan
